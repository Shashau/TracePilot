# Copy this file to config.env to test your own authorized API.
# No setting is needed for the built-in seeded demo.
# Exact origins only (scheme + host + optional port), separated by commas.
# TRACEPILOT_ALLOWED_ORIGINS=http://127.0.0.1:9000,https://your-authorized-api.example
# Store only the reference in the suite: "header_env": {"Authorization": "TRACEPILOT_SECRET_AUTH"}
# TRACEPILOT_SECRET_AUTH=Bearer your-test-token
# Optional database override. Relative paths are relative to the extracted project.
# TRACEPILOT_DB=data/tracepilot.sqlite3
